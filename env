#--------------------------------------------------------------------
# NOTIFICACIONES PUSH (API notificaciones-push-roma)
#--------------------------------------------------------------------
# El registro de dispositivos y el envío los hace la API de notificaciones.
# Las API keys son por compañía y se guardan en la BD (Panel > Notificaciones,
# tabla CompanyPushKeys: app/Database/sql/PushApiKeys.sql).
# pushapi.baseURL = https://push.tu-dominio.com/api/v1
# Opcional: llave por defecto para compañías sin llave propia
# pushapi.apiKey = pk_xxxxxxxxxxxx.yyyyyyyy
# Solo si la llave por defecto es global (4 caracteres):
# pushapi.organizacion = ROMA
# true = la API encola el envío (requiere php spark push:worker en la API)
# pushapi.asincrono = false
# Si el log dice "SSL certificate problem: unable to get local issuer certificate":
# ruta absoluta a cacert.pem (https://curl.se/ca/cacert.pem) o configure curl.cainfo en php.ini
# pushapi.caBundle = C:/php/extras/ssl/cacert.pem
